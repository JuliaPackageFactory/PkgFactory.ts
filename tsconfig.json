{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "types": ["node", "@cloudflare/workers-types"],
    "allowImportingTsExtensions": true
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
