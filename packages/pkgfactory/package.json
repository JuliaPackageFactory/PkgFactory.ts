{
  "name": "@juliapackagefactory/pkgfactory",
  "version": "0.1.0",
  "description": "Create Julia packages from Node.js, the web, and MCP",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JuliaPackageFactory/PkgFactory.ts.git"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "pkgfactory": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "docs",
    "examples"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@serenity-kit/noble-sodium": "0.2.3",
    "mustache": "4.2.0",
    "zod": "4.6.5"
  }
}
