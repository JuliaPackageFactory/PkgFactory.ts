{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pkgfactory-ts-staging",
  "main": "dist/worker.js",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["enable_request_signal", "global_fetch_strictly_public"],
  "workers_dev": true,
  "limits": {"cpu_ms": 30000},
  "observability": {"enabled": false},
  "vars": {"ORIGIN": "https://pkgfactory-ts-staging.YOUR-SUBDOMAIN.workers.dev", "GITHUB_OAUTH_CLIENT_ID": "CONFIGURE_ME", "KEY_ALGORITHM": "ed25519", "MAINTENANCE": "false"},
  "durable_objects": {"bindings": [{"name": "STATE", "class_name": "ApplicationState"}, {"name": "AUTH", "class_name": "AuthState"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ApplicationState", "AuthState"]}],
  "kv_namespaces": [{"binding": "OAUTH_KV", "id": "CONFIGURE_STAGING_KV_ID"}],
  "env": {"production": {
    "name": "pkgfactory",
    "vars": {"ORIGIN": "https://pkgfactory.YOUR-SUBDOMAIN.workers.dev", "GITHUB_OAUTH_CLIENT_ID": "CONFIGURE_ME", "KEY_ALGORITHM": "ed25519", "MAINTENANCE": "true"},
    "durable_objects": {"bindings": [{"name": "STATE", "class_name": "ApplicationState"}, {"name": "AUTH", "class_name": "AuthState"}]},
    "kv_namespaces": [{"binding": "OAUTH_KV", "id": "CONFIGURE_PRODUCTION_KV_ID"}]
  }}
}
