{
  "name": "pkgfactory-repository",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "templates": "node scripts/templates.mjs",
    "prepare": "npm run templates",
    "build": "node scripts/build.mjs",
    "pretypecheck": "npm run templates",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run templates",
    "test": "tsx --test test/*.test.ts",
    "pretest:worker": "npm run templates",
    "test:worker": "tsx --test test/worker/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:worker",
    "poc": "tsx scripts/key-poc.ts",
    "pree2e": "npm run templates",
    "e2e": "tsx scripts/github-e2e.ts",
    "pree2e:templates": "npm run templates",
    "e2e:templates": "tsx scripts/template-repositories.ts",
    "e2e:staging": "tsx scripts/staging-mcp-e2e.ts",
    "dev:worker": "wrangler dev --config apps/cloudflare/wrangler.jsonc",
    "deploy:staging": "wrangler deploy --config apps/cloudflare/wrangler.jsonc",
    "deploy:production": "wrangler deploy --config apps/cloudflare/wrangler.jsonc --env production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "@types/mustache": "4.2.6",
    "@types/node": "26.6.4",
    "@iarna/toml": "2.2.5",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "libsodium-wrappers": "0.8.4",
    "miniflare": "5.20260926.1-alpha",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.147.0",
    "yaml": "2.9.1"
  }
}
