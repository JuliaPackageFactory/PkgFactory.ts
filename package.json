{
  "name": "pkgfactory-repository",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "embed": "node scripts/templates.mjs && node scripts/assets.mjs",
    "prepare": "npm run embed",
    "build": "node scripts/build.mjs",
    "pretypecheck": "npm run embed",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run embed",
    "test": "tsx --test test/node/*.test.ts",
    "pretest:worker": "npm run embed",
    "test:worker": "tsx --test test/worker/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:worker",
    "poc": "tsx scripts/poc/keys.ts",
    "pree2e": "npm run embed",
    "e2e": "tsx scripts/e2e/node.ts",
    "pree2e:templates": "npm run embed",
    "e2e:templates": "tsx scripts/e2e/template-repositories.ts",
    "e2e:staging": "tsx scripts/e2e/staging.ts",
    "dev:worker": "wrangler dev --config apps/cloudflare/wrangler.jsonc",
    "deploy:staging": "wrangler deploy --config apps/cloudflare/wrangler.jsonc",
    "deploy:production": "wrangler deploy --config apps/cloudflare/wrangler.jsonc --env production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "@types/mustache": "4.2.6",
    "@types/node": "26.6.6",
    "@iarna/toml": "2.2.5",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "libsodium-wrappers": "0.8.4",
    "miniflare": "5.20260926.1-alpha",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.156.1",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "workerd@1.20260926.1": true,
    "workerd@1.20261012.1": true,
    "esbuild@0.28.2": true
  }
}
